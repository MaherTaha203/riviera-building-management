# ---------------------------------------------------------------------------
# Riviera Building Management — frontend environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser by Vite.
# These are inlined at BUILD time, so they must be set before `vite build`.

# Backend API base URL (no trailing slash).
#   - Local development: the API server defaults to http://localhost:8080.
#     If you omit this variable in dev, the app falls back to that URL.
#   - Production: set this to your deployed API, e.g.
#     https://riviera-api.onrender.com
VITE_API_URL=http://localhost:8080
